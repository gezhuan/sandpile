sphere    = ptype        Particle type: sphere / cube / tetra / rice
1         = Render       Produce visualization files
20.0      = L_x          x length
20.0      = L_y          y length
10.0      = L_z          z length
5e-6      = dt           DEM time step
-981.0    = Dp           gravitational acceleration
0.15      = R            particle radius / characteristic size
500.0     = Tf1          packing stage duration
0.2       = dtOut1       regular packing output interval
100       = Tf2          avalanche stage duration
0.2       = dtOut2       regular avalanche output interval
10.0      = height       particle injection height during packing
10.0      = height2      particle injection height during avalanche
7.0       = R_base       base/table radius
2.65      = rho_s        particle density
0.01      = w_th         wall / shape thickness
0.5       = Muw          wall friction coefficient
1.0e9     = Kn           normal stiffness
4.0e8     = Kt           tangential stiffness
-0.5      = Gn           particle damping / restitution parameter
-0.2      = Gnb          bottom damping parameter
0.1       = Rp_base      base particle size
-0.01     = Gnw          wall damping parameter
1.0       = sizedis      particle size distribution parameter
0.4       = MUP          particle friction coefficient
90        = Ang          angle parameter
1.0       = fraction     generation fraction
2.0      = R_source     particle source radius
50000    = Nump         maximum injected particle number
vari       = tp           multiplier for particle insertion interval
1         = Anumper      particles added per injection event
hertz     = contactlaw   contact model
1         = stage_packing
1         = stage_AVA
1.0       = scaleR       cube/tetra/rice size scaling
0         = highOutputPacking
0.0       = highT1Packing
200.0     = highT2Packing
0.01      = dtHighPacking
0         = highOutputAvalanche
0.2       = highT1Avalanche
1.0     = highT2Avalanche
0.01      = dtHighAvalanche

