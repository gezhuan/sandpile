sphere    = ptype        Particle type: sphere / cube / tetra / rice
1         = Render       Produce visualization files
20.0      = L_x          x length
20.0      = L_y          y length
10.0      = L_z          z length
5e-5      = dt           DEM time step
-981.0    = Dp           gravitational acceleration
0.15      = R            particle radius / characteristic size
200       = Tf1          packing stage duration
0.1       = dtOut1       regular packing output interval
200       = Tf2          avalanche stage duration
0.1       = dtOut2       regular avalanche output interval
8.0       = height       particle injection height during packing
8.5       = height2      particle injection height during avalanche
9.2       = R_base       base/table radius
1.04      = rho_s        particle density
0.01      = w_th         wall / shape thickness
0.52      = Muw          wall friction coefficient
2.3e6     = Kn           normal stiffness
0.9e6     = Kt           tangential stiffness
-0.5      = Gn           particle damping / restitution parameter
-0.2      = Gnb          bottom damping parameter
0.1       = Rp_base      base particle size
-0.05     = Gnw          wall damping parameter
1.0       = sizedis      particle size distribution parameter
0.28      = MUP          particle friction coefficient
90        = Ang          angle parameter
1.0       = fraction     generation fraction
10.0      = R_source     particle source radius
100000    = Nump         maximum injected particle number
1.5       = tp           multiplier for particle insertion interval
1         = Anumper      particles added per injection event
hertz     = contactlaw   contact model
0         = stage_packing
1         = stage_AVA
1.0       = scaleR       cube/tetra/rice size scaling
0         = highOutputPacking
0.0       = highT1Packing
200.0     = highT2Packing
0.01      = dtHighPacking
0         = highOutputAvalanche
0.2       = highT1Avalanche
1.0     = highT2Avalanche
0.01      = dtHighAvalanche

